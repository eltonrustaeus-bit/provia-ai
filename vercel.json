{
  "buildCommand": "node tools/prepare-vercel-runtime.mjs",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'" }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/exgen-school-pilot-review-2026-10-13": true,
      "codex/exgen-generation-quality-2026-10-20": true
    }
  },
  "functions": {
    "api/stripe-webhook.js": {
      "maxDuration": 10
    },
    "api/create-checkout-session.js": {
      "maxDuration": 15
    },
    "api/grade.js": {
      "maxDuration": 60
    },
    "api/generate-exam.js": {
      "maxDuration": 60
    },
    "api/teacher-report.js": {
      "maxDuration": 60
    },
    "api/check-role.js": {
      "maxDuration": 60,
      "includeFiles": "config/**"
    },
    "api/ocr.js": {
      "maxDuration": 60,
      "includeFiles": "src/per/**"
    },
    "api/explain.js": {
      "maxDuration": 60,
      "includeFiles": "config/**"
    }
  }
}
